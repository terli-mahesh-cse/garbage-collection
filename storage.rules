rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Reports images & videos
    match /reports/{reportId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/mp4'))
        && request.resource.size < 25 * 1024 * 1024; // 25 MB max
    }

    // Event before/after gallery photos
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // User avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
